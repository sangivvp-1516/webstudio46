# Copy this file to '.env' and fill in your actual credentials.
# NEVER commit the real '.env' file to Git!

# Server Port
PORT=3000

# Studio Admin Email (Where you receive all client project enquiries)
STUDIO_EMAIL=webstudio46.in@gmail.com

# SMTP Email Configuration (Nodemailer for Gmail)
# For Gmail, generate a 16-character App Password at:
# https://myaccount.google.com/apppasswords
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=webstudio46.in@gmail.com
SMTP_PASS=your_16_character_app_password

# Environment Mode: 'development' or 'production'
NODE_ENV=development

